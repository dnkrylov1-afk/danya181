{
  "rules": {
    ".read": false,
    ".write": false,
    "pages": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && auth.token.role === 'admin' && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "pageTitles": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      ".write": false
    },
    "templates": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      ".write": false
    },
    "users": {
      ".read": "auth != null && auth.token.role === 'admin' && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false,
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || (auth.token.role === 'admin' && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".write": false
      }
    }
  }
}
